+    /** "Biomes O' Plenty: " for a biomesoplenty biome, "Minecraft: " for vanilla, the namespace itself for an unknown mod. */
+    private static String biomeOwner(net.minecraft.world.biome.Biome biome) {
+        net.minecraft.util.ResourceLocation name = biome.getRegistryName();
+        if (name == null) {
+            return "";
+        }
+        net.minecraftforge.fml.common.ModContainer mod = net.minecraftforge.fml.common.Loader.instance().getIndexedModList().get(name.getNamespace());
+        return (mod != null ? mod.getName() : name.getNamespace()) + ": ";
+    }
